[Unit]
Description=Project Roadmap API
After=network.target

[Service]
Type=simple
User=project-roadmap
Group=project-roadmap
WorkingDirectory=/opt/project-roadmap
Environment=PYTHONPATH=/opt/project-roadmap/backend
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/project-roadmap/venv/bin/python -c "from app import run_migrations; run_migrations()"
ExecStart=/opt/project-roadmap/venv/bin/gunicorn --pythonpath /opt/project-roadmap/backend --bind 127.0.0.1:5002 --workers 1 --threads 1 --timeout 30 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/project-roadmap/data

[Install]
WantedBy=multi-user.target
